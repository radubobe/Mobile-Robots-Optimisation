


P=? [ G ([lw]!=0 ^ [rw]!=0) ]

P=? [ F ([lw]!=[rw]) ]

P=? [ F([s1]>0 V [s2]>0 V [s3]>0 V [s4]>0 V [s5]>0 V [s6]>0)]


P=? [  F(([s1]+[s2]+[s3]>0) ^ ([s4]+[s5]+[s6]=0)  ^ X( X (X( [lw] <= [rw] )) ) )]

P=? [ F(([s1]+[s2]+[s3]=0) ^([s4]+[s5]+[s6]>0)^ X( X (X( [lw] >= [rw] )) ) )]

P=? [ F (([lw]>[rw]) ^ X([lw]<[rw])) ]

P=? [ F (([lw]!=[rw]) ^ X([lw]=[rw])) ]






